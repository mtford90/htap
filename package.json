{
  "name": "@mtford/httap",
  "version": "0.9.0",
  "description": "Terminal HTTP interception toolkit",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "httap": "dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/cli/index.js",
    "./interceptors": {
      "types": "./dist/interceptors.d.ts",
      "default": "./dist/interceptors.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "agents": {
    "skills": [
      {
        "name": "httap",
        "path": "./skills/httap"
      }
    ]
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --dir src",
    "test:int": "vitest run --dir tests/integration",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "seed": "npx tsx scripts/seed.ts",
    "simulate": "npx tsx scripts/simulate.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "http",
    "https",
    "proxy",
    "intercept",
    "mitm",
    "debugging",
    "cli",
    "tui",
    "terminal"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtford90/httap.git"
  },
  "bugs": {
    "url": "https://github.com/mtford90/httap/issues"
  },
  "homepage": "https://github.com/mtford90/httap#readme",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=26.4.0"
  },
  "dependencies": {
    "@ink-tools/ink-mouse": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "cli-highlight": "^2.1.11",
    "commander": "^15.0.0",
    "global-agent": "^4.1.3",
    "ink": "^7.1.1",
    "ink-use-stdout-dimensions": "^1.0.5",
    "jiti": "^2.7.0",
    "mockttp": "^4.6.2",
    "react": "^19.2.8",
    "safe-regex2": "^5.1.1",
    "undici": "^8.10.1",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cli-testing-library": "^4.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
